  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "The run loop validates config, reads a createdDate window from MSSQL, and copies missing objects into MinIO.",
        "Each row is tracked in SQLite so retries, watermark progress, and reconcile state survive restarts."
      ]
    },
    {
      "dot": "emerald",
      "title": "Trust model",
      "items": [
        "MSSQL is treated as read-only and never mutated by the service.",
        "The local SQLite volume is the source of truth for runtime progress and transient failure state.",
        "The MinIO bucket is the controlled backup destination; Postgres is optional and reporting-only."
      ]
    },
    {
      "dot": "violet",
      "title": "External dependencies",
      "items": [
        "ODF RGW/S3 source bucket for object retrieval.",
        "MinIO destination bucket for backup writes.",
        "Optional PostgreSQL store for long-lived reporting and result tables."
      ]
    }
  ]
