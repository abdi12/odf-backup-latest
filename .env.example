# ---------- MSSQL (read only: the service only runs SELECT here) ----------
MSSQL_HOST=mssql.example.local
MSSQL_PORT=1433
MSSQL_DATABASE=DocumentDB
MSSQL_USER=svc_odf_backup_ro
# MSSQL_PASSWORD comes from ./secrets/mssql_password
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=false
SOURCE_TABLE=dbo.Documents
COL_DOC_URL=docUrl
COL_CREATED=createdDate
# Set true only if createdDate is stored in UTC
CREATED_DATE_IS_UTC=false

# ---------- Source: ODF S3 on OCP 4.15 ----------
# S3 endpoint for the bucket in docUrl. If storage.apps.btpnsyariah.com IS the
# S3 route, use it; otherwise use the RGW/NooBaa S3 route.
SRC_S3_ENDPOINT=https://storage.apps.btpnsyariah.com
SRC_S3_ACCESS_KEY=CHANGE_ME
# SRC_S3_SECRET_KEY comes from ./secrets/src_s3_secret_key
SRC_S3_BUCKET=images
# Reject docUrls pointing at other hosts (leave empty to accept any host)
SRC_URL_HOST=storage.apps.btpnsyariah.com
SRC_S3_CA_BUNDLE=/certs/ocp-ingress-ca.pem

# ---------- Destination: MinIO ----------
DST_S3_ENDPOINT=https://minio.example.local:9000
DST_S3_ACCESS_KEY=CHANGE_ME
# DST_S3_SECRET_KEY comes from ./secrets/dst_s3_secret_key
DST_S3_BUCKET=images-backup
# Optional key prefix in the backup bucket (empty = same keys as source)
DST_S3_PREFIX=
DST_S3_CA_BUNDLE=/certs/minio-ca.pem

# ---------- Runtime ----------
WORKERS=16
# Each run re-reads this many minutes before the watermark (catches late commits)
OVERLAP_MINUTES=15
# Ignore rows newer than now - lag (transactions still committing)
SAFETY_LAG_MINUTES=2
# First run only. Empty = today 00:00 (DB clock). Example: 2026-09-30T00:00:00
START_FROM=
MAX_ATTEMPTS=10
RETRY_BATCH=5000
# Stop starting new copies after this long; leftovers go to the next run
MAX_RUN_MINUTES=9
# true = exit code 1 when some copies failed (they are retried next run either way)
STRICT_EXIT=true
LOG_LEVEL=INFO

# ---------- Backfill ----------
# Set BACKFILL_FROM to mirror older data. Each run spends its spare time on it.
# BACKFILL_TO empty = the moment incremental mirroring started.
BACKFILL_FROM=
BACKFILL_TO=
BACKFILL_CHUNK_MINUTES=60
BACKFILL_WORKERS=8

# ---------- Reconcile ----------
RECONCILE_ENABLED=true
# Yesterday is reconciled on the first run after this hour (DB clock)
RECONCILE_HOUR=1
# Check every object in MinIO, not only the local records
RECONCILE_VERIFY_DEST=true

# ---------- Result records ----------
# One record per backed-up object (key, docUrl, createdDate, size, time) is kept
# in /data/state.db. 0 = keep forever.
RESULT_RETENTION_DAYS=0
# Optional PostgreSQL result store. Empty PG_HOST = state.db only.
PG_HOST=
PG_PORT=5432
PG_DATABASE=doma-object
PG_SCHEMA=public
PG_SSLMODE=prefer
PG_USER=
# PG_PASSWORD, or PG_PASSWORD_FILE pointing at a mounted secret
PG_PASSWORD=
